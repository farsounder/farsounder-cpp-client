{"openapi":"3.1.0","info":{"title":"SonaSoft Navigation API","description":"\nAPI to access processed sonar data from SonaSoft.\n\nThis API is intended to be used to retrieve processed sonar data from SonaSoft,\nand to provide a means to control SonaSoft. It gives access to the live,\nping-to-ping data as well as the history data that is stored locally in a\ndatabase.\n\nData can be polled for over HTTP, or streamed over a WebSocket. All the data\nis in JSON format. The websocket endpoint does not handle requests, it is\nonly used to push data to any connected clients whenever it becomes available.\n\nThe HTTP API can be used to get history data or to change settings, etc.\n\nIf you have any questions please contact us!\n","contact":{"name":"FarSounder Inc.","url":"https://www.farsounder.com/software-development-kit","email":"service@farsounder.com"},"license":{"name":"License Agreement Required for Commercial Use","url":"https://www.farsounder.com/software-development-kit"},"version":"0.1.0"},"paths":{"/api/history_data":{"get":{"tags":["History Data"],"summary":"Get the latest history data","description":"Get the latest Local History Mapping data.\n\nThis endpoint returns the latest Local History Mapping data from the history\ndatabase. This includes gridded bottom and inwater detections within the\nspecified radius of the given latitude and longitude. If since_timestamp_utc\nis specified, then only data that has been collected or updated since that\ntime will be returned. If since_timestamp_utc is not specified, then all the\ndata in the radius will be returned.\n\nThe limit and skip parameters can be used to paginate through the data. The\ntotal number of records available is returned\nin the X-Grids-Count header. If include_count is False, then the X-Grids-Count\nheader will not be included in the response (count is expensive).","operationId":"history_data_api_history_data_get","parameters":[{"name":"latitude","in":"query","required":true,"schema":{"type":"number","exclusiveMaximum":90.0,"exclusiveMinimum":-90.0,"title":"Latitude Decimal Degrees","description":"Latitude in decimal degrees","examples":[41.7223,42.7223,43.7223]},"description":"Latitude in decimal degrees"},{"name":"longitude","in":"query","required":true,"schema":{"type":"number","exclusiveMaximum":180.0,"exclusiveMinimum":-180.0,"title":"Longitude Decimal Degrees","description":"Longitude in decimal degrees","examples":[-71.35,-72.35,-73.35]},"description":"Longitude in decimal degrees"},{"name":"radius_meters","in":"query","required":false,"schema":{"type":"number","maximum":2000.0,"exclusiveMinimum":0.0,"title":"Query radius in Meters","description":"Radius within which to query for history data, in Meters. This is approximate. For performance reasons we query a bounding box instead, data on the corners may be more than this radius away.","examples":[500.0,1000.0,2000.0],"default":500.0},"description":"Radius within which to query for history data, in Meters. This is approximate. For performance reasons we query a bounding box instead, data on the corners may be more than this radius away."},{"name":"since_timestamp_utc","in":"query","required":false,"schema":{"type":"number","exclusiveMinimum":0.0,"title":"Return data that has been collected or updated since this time","description":"Return data that has been collected or updated since this time in UTC seconds since the linux epoch. If it is not specified, then all the data in the radius will be returned. ","examples":[1623345600.0,1623345600.0,1623345600.0]},"description":"Return data that has been collected or updated since this time in UTC seconds since the linux epoch. If it is not specified, then all the data in the radius will be returned. "},{"name":"tide_corrected_only","in":"query","required":false,"schema":{"type":"boolean","title":"Only return tide corrected seafloor detections","description":"Only return tide corrected seafloor detections. This flag doesn't affect in-water detections.","examples":[true,false],"default":false},"description":"Only return tide corrected seafloor detections. This flag doesn't affect in-water detections."},{"name":"skip","in":"query","required":false,"schema":{"type":"integer","default":0,"title":"Skip"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":50000,"title":"Limit"}},{"name":"include_count","in":"query","required":false,"schema":{"type":"boolean","default":true,"title":"Include Count"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HistoryData"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/target_data":{"get":{"tags":["Realtime Data"],"summary":"Get the latest realtime detection data","description":"This endpoint returns the latest detection data from the realtime processor.\n    This includes realtime detections from the latest ping of both seafloor\n    and in-water targets. The latest data will continue to be returned until\n    it's older than 10 seconds, after which, None will be returned\n    until new data is available.","operationId":"target_data_api_target_data_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TargetData"}}}}}}},"/api/filtered_navigation_data":{"get":{"tags":["Realtime Data"],"summary":"Get the latest filtered navigation data (heading, position, speed, etc.)","description":"This endpoint returns the latest filtered navigation data (heading,\n    position, speed, etc.) from any NMEA streams connected to SonaSoft. These\n    are configured in the SonaSoft settings under the \"NMEA Settings\" section\n    and can be connected via serial or ethernet (UDP or TCP). This stream is\n    passed through a Kalman filter to get a smoothed heading, position, and\n    speed.\n    The latest data will continue to be returned until it's older than\n    10 seconds, after which, None will be returned until new data\n    is available.","operationId":"filtered_navigation_data_api_filtered_navigation_data_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FilteredState"}}}}}}},"/api/depth":{"get":{"tags":["Realtime Data"],"summary":"Get the latest depth data","description":"This endpoint returns the latest depth data from any connected NMEA\n    depthsounder. The latest data will continue to be returned until it's older\n    than 10 seconds, after which, None will be returned until new\n    data is available.","operationId":"depth_api_depth_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Depth"}}}}}}},"/api/signal_quality":{"get":{"tags":["Realtime Data"],"summary":"Get the latest signal quality data","description":"This endpoint returns the latest signal quality calculation based on the\n    latest ping of the connected Argos sonar. The latest data will continue to\n    be returned until it's older than 10 seconds, after which, None\n    will be returned until new data is available.","operationId":"signal_quality_api_signal_quality_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SignalQuality"}}}}}}},"/api/processor_settings":{"get":{"tags":["Settings"],"summary":"Get the current processor settings","description":"Get the latest processor settings.","operationId":"processor_settings_api_processor_settings_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProcessorSettings"}}}}}},"patch":{"tags":["Settings"],"summary":"Change the current processor settings","description":"Update the current processor settings.\n\nThis endpoint is used to change the current processor settings. The settings\nincluded in the request will be updated, the rest will be left unchanged.","operationId":"update_processor_settings_api_processor_settings_patch","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProcessorSettingsUpdate"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProcessorSettings"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/sensor_layout":{"get":{"tags":["Settings"],"summary":"Get the current sensor layout","description":"Get the current sensor layout for the system.\n\nThis endpoint returns the current sensor layout for the system. It describes\nthe location of the sensors on the vessel that are relevant for the Argos\nsystem along with vessel size, etc. Useful for drawing the boat to scale and\nfor placing sonar data correctly in displays.\n\nThe coordinate system is relative to the vessel. The origin is the centerline\nof the vessel at the stern. The y-axis is the centerline of the vessel, with\npositive values forward. The x-axis is perpendicular to the centerline, with\npositive values to the port side (left)!!!. The z-axis is vertical, with\npositive values up, negative values down from the waterline.\n\nThe units are all in meters.","operationId":"get_sensor_layout_api_sensor_layout_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SensorLayout"}}}}}}},"/api/alarm/settings":{"get":{"tags":["Alarm"],"summary":"Get the current alarm settings","description":"Get the current alarm settings.","operationId":"get_alarm_settings_api_alarm_settings_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AlarmSettings"}}}}}},"post":{"tags":["Alarm"],"summary":"Update the current alarm settings","description":"Update the current alarm settings.","operationId":"update_alarm_settings_api_alarm_settings_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AlarmSettings"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AlarmSettings"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/alarm/acknowledge":{"post":{"tags":["Alarm"],"summary":"Acknowledge an alarm","description":"Acknowledge an alarm.","operationId":"acknowledge_alarm_api_alarm_acknowledge_post","parameters":[{"name":"unique_id","in":"query","required":true,"schema":{"type":"string","title":"Unique Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/alarm/active":{"get":{"tags":["Alarm"],"summary":"Get the active alarms","description":"Get the active alarms.","operationId":"get_active_alarms_api_alarm_active_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"items":{"$ref":"#/components/schemas/Alarm"},"type":"array","title":"Response Get Active Alarms Api Alarm Active Get"}}}}}}},"/charts/tiles/{z}/{x}/{y}":{"get":{"tags":["Charts"],"summary":"Get a single chart tile for a given zoom level, x, and y.","description":"Get a single chart tile for a given zoom level, x, and y.\n\nThe format is the standard tms format. The image is returned in png format,\nand the file extension on the URL string is not required, but if included it\nmust be .png.","operationId":"chart_tile_charts_tiles__z___x___y__get","parameters":[{"name":"z","in":"path","required":true,"schema":{"type":"integer","title":"Z"}},{"name":"x","in":"path","required":true,"schema":{"type":"integer","title":"X"}},{"name":"y","in":"path","required":true,"schema":{"type":"string","title":"Y"}},{"name":"units","in":"query","required":false,"schema":{"type":"string","default":"meters","title":"Units"}},{"name":"theme","in":"query","required":false,"schema":{"enum":["day","night","dusk"],"type":"string","default":"day","title":"Theme"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/charts/static/":{"get":{"tags":["Charts"],"summary":"Get a static chart image for a given lat, lon, and scale.","description":"Get a static chart image for a given latitude, longitude, and scale.\n\nThe image is returned in png format.","operationId":"chart_static_charts_static__get","parameters":[{"name":"lat","in":"query","required":true,"schema":{"type":"number","title":"Lat"}},{"name":"lon","in":"query","required":true,"schema":{"type":"number","title":"Lon"}},{"name":"scale","in":"query","required":true,"schema":{"type":"number","title":"Scale"}},{"name":"units","in":"query","required":false,"schema":{"type":"string","default":"meters","title":"Units"}},{"name":"theme","in":"query","required":false,"schema":{"enum":["day","night","dusk"],"type":"string","default":"day","title":"Theme"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/charts/test":{"get":{"tags":["Charts"],"summary":"View chart tiles in a simple web map.","description":"View chart tiles in a simple web map.\n\nGot to \"this ip:port/charts/test\" to view a map with access to the chart\ndata that is loaded in the system in your browser.","operationId":"test_charts_test_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/third_party/cam/rgb/whep":{"post":{"tags":["Third Party Data"],"summary":"Whep Endpoint","description":"WebRTC HTTP Egress Protocol (WHEP) endpoint.\n\nThis endpoint handles the WebRTC signaling for the RTSP stream.\nIt accepts a POST request with an SDP offer and returns an SDP answer.","operationId":"whep_endpoint_third_party_cam_rgb_whep_post","parameters":[{"name":"cameraUrl","in":"query","required":false,"schema":{"type":"string","default":"rtsp://localhost:8554/mystream","title":"Cameraurl"}},{"name":"transport","in":"query","required":false,"schema":{"enum":["tcp","udp"],"type":"string","default":"tcp","title":"Transport"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/third_party/targets":{"get":{"tags":["Third Party Data"],"summary":"Get Generic Targets","description":"Get generic targets.\n\nThis endpoint returns the latest generic target data from the third party\ndata consumer.\n\nThis is a data coming from a third party data stream like:\n  - Sea.AI (camera targets from TTM messages)\n\nIt's a list of GenericTarget objects that have not expired yet. The default\nTTL is 2 seconds. You will get the latest 2 seconds of data with each\nrequest.","operationId":"get_generic_targets_third_party_targets_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"items":{"$ref":"#/components/schemas/GenericTarget"},"type":"array","title":"Response Get Generic Targets Third Party Targets Get"}}}}}}},"/ws":{"get":{"tags":["Websocket"],"summary":"Description of possible websocket messages","description":"For documentation. Return type describes the possible ws messages.\n\nAny connected clients will receive messages as they are available. The\nrate depends on the data source. TargetData from the sonar will be between\n~0.3-3 Hz depending on the operation range.\n\nThe messages mirror the message types of the HTTP API responses and are listed\nas the response model of this endpoint for inspection in the docs. The\nmessage contains a message type field and a payload field that matches\nthe actual JSON response from the HTTP API.","operationId":"doc_websocket_endpoint_ws_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/AlarmWebSocketMessage"},{"$ref":"#/components/schemas/DepthWebSocketMessage"},{"$ref":"#/components/schemas/FilteredNavigationDataWebSocketMessage"},{"$ref":"#/components/schemas/GenericTargetWebSocketMessage"},{"$ref":"#/components/schemas/ProcessorSettingsWebSocketMessage"},{"$ref":"#/components/schemas/SensorLayoutWebSocketMessage"},{"$ref":"#/components/schemas/SignalQualityWebSocketMessage"},{"$ref":"#/components/schemas/TargetDataWebSocketMessage"},{"type":"string"}],"title":"Response Doc Websocket Endpoint Ws Get"}}}}}}},"/ws/test":{"get":{"tags":["Websocket"],"summary":"Simple trace of websocket messages","description":"Simple trace of websocket messages.\n\nLoad this page to watch the stream of websocket messages in real-time,\nuseful for debugging and testing.","operationId":"test_websocket_ws_test_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}}},"components":{"schemas":{"Alarm":{"properties":{"unique_id":{"type":"string","title":"Unique Id"},"triggered_at":{"type":"number","title":"Triggered At"},"message":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Message"}},"type":"object","required":["unique_id","triggered_at"],"title":"Alarm","description":"Data model for an alarm."},"AlarmAcknowledged":{"properties":{"alarm":{"$ref":"#/components/schemas/Alarm"},"ackd_at":{"type":"number","title":"Ackd At"}},"type":"object","required":["alarm","ackd_at"],"title":"AlarmAcknowledged","description":"Data model for an acknowledged alarm."},"AlarmEvent":{"properties":{"event_type":{"type":"string","enum":["alarm_settings","alarm_triggered","alarm_acknowledged","alarm_service_heartbeat"],"title":"Event Type"},"payload":{"anyOf":[{"$ref":"#/components/schemas/AlarmSettings"},{"$ref":"#/components/schemas/AlarmTriggered"},{"$ref":"#/components/schemas/AlarmAcknowledged"},{"additionalProperties":{"type":"number"},"type":"object"},{"type":"null"}],"title":"Payload"}},"type":"object","required":["event_type"],"title":"AlarmEvent","description":"Data model for an alarm event."},"AlarmSettings":{"properties":{"range_start_meters":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Range Start Meters"},"range_end_meters":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Range End Meters"},"fov_degrees":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Fov Degrees"},"depth_meters":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Depth Meters"},"hits":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Hits"},"enabled":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Enabled"}},"type":"object","title":"AlarmSettings","description":"Data model for alarm settings."},"AlarmTriggered":{"properties":{"alarm":{"$ref":"#/components/schemas/Alarm"}},"type":"object","required":["alarm"],"title":"AlarmTriggered","description":"Data model for a triggered alarm."},"AlarmWebSocketMessage":{"properties":{"type":{"const":"alarm_event","title":"Type"},"payload":{"$ref":"#/components/schemas/AlarmEvent"}},"type":"object","required":["type","payload"],"title":"AlarmWebSocketMessage"},"ArgosNode":{"properties":{"hostname":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Hostname"},"description":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Description"},"ip_offset":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Ip Offset"},"x":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"X"},"y":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Y"},"z":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Z"},"look_dir":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Look Dir"},"fov_left":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Fov Left"},"fov_right":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Fov Right"},"neighbor_left":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Neighbor Left"},"neighbor_right":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Neighbor Right"},"sonar_serial":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Sonar Serial"},"rom":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Rom"}},"type":"object","title":"ArgosNode"},"Depth":{"properties":{"depth_meters":{"type":"number","title":"Depth Meters"},"timestamp_utc":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Timestamp Utc"}},"type":"object","required":["depth_meters"],"title":"Depth","description":"Data model for depth."},"DepthWebSocketMessage":{"properties":{"type":{"const":"depth","title":"Type"},"payload":{"$ref":"#/components/schemas/Depth"}},"type":"object","required":["type","payload"],"title":"DepthWebSocketMessage"},"Depthsounder":{"properties":{"description":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Description"},"x":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"X"},"y":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Y"},"z":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Z"}},"type":"object","title":"Depthsounder"},"Detection":{"properties":{"cross_range_meters":{"type":"number","title":"Cross Range Meters"},"down_range_meters":{"type":"number","title":"Down Range Meters"},"depth_meters":{"type":"number","title":"Depth Meters"},"target_strength_db":{"type":"number","title":"Target Strength Db"}},"type":"object","required":["cross_range_meters","down_range_meters","depth_meters","target_strength_db"],"title":"Detection"},"FOVType":{"type":"string","enum":["120 degrees, 100 meters","120 degrees, 200 meters","90 degrees, 100 meters","90 degrees, 200 meters","90 degrees, 350 meters","90 degrees, 500 meters","60 degrees, 1000 meters","Standby"],"title":"FOVType","description":"Enum for field of view types."},"FilteredNavigationDataWebSocketMessage":{"properties":{"type":{"const":"filtered_navigation_data","title":"Type"},"payload":{"$ref":"#/components/schemas/FilteredState"}},"type":"object","required":["type","payload"],"title":"FilteredNavigationDataWebSocketMessage"},"FilteredState":{"properties":{"timestamp_utc":{"type":"number","title":"Timestamp Utc"},"filtered_latitude":{"type":"number","title":"Filtered Latitude"},"filtered_longitude":{"type":"number","title":"Filtered Longitude"},"latlon_is_filtered":{"type":"boolean","title":"Latlon Is Filtered"},"filtered_heading_deg":{"type":"number","title":"Filtered Heading Deg"},"heading_is_filtered":{"type":"boolean","title":"Heading Is Filtered"},"speed":{"type":"number","title":"Speed"},"course":{"type":"number","title":"Course"},"rot":{"type":"number","title":"Rot"}},"type":"object","required":["timestamp_utc","filtered_latitude","filtered_longitude","latlon_is_filtered","filtered_heading_deg","heading_is_filtered","speed","course","rot"],"title":"FilteredState","description":"Data model for filtered state."},"GPS":{"properties":{"description":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Description"},"x":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"X"},"y":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Y"}},"type":"object","title":"GPS"},"GenericTarget":{"properties":{"timestamp_utc":{"type":"number","title":"Timestamp Utc"},"provider_name":{"type":"string","title":"Provider Name"},"provider_raw_sensor_data":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Provider Raw Sensor Data"},"additional_target_metadata":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Additional Target Metadata"},"position_type":{"anyOf":[{"$ref":"#/components/schemas/PositionType"},{"type":"null"}]},"position_geo":{"anyOf":[{"$ref":"#/components/schemas/Position"},{"type":"null"}]},"position_relative":{"anyOf":[{"$ref":"#/components/schemas/PositionRelative"},{"type":"null"}]},"classification":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Classification"},"id":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Id"}},"type":"object","required":["timestamp_utc","provider_name"],"title":"GenericTarget","description":"Data model for generic target data from third-party systems."},"GenericTargetWebSocketMessage":{"properties":{"type":{"const":"generic_target","title":"Type"},"payload":{"$ref":"#/components/schemas/GenericTarget"}},"type":"object","required":["type","payload"],"title":"GenericTargetWebSocketMessage"},"GriddedBottomDetection":{"properties":{"timestamp_utc":{"type":"number","title":"Timestamp Utc"},"latitude_degrees":{"type":"number","title":"Latitude Degrees"},"longitude_degrees":{"type":"number","title":"Longitude Degrees"},"grid_interval_meters":{"type":"number","title":"Grid Interval Meters"},"target_strength_db":{"type":"number","title":"Target Strength Db"},"is_tide_corrected":{"type":"boolean","title":"Is Tide Corrected"},"uploaded_to_cloud":{"type":"boolean","title":"Uploaded To Cloud"},"number_of_points":{"type":"integer","title":"Number Of Points"},"depth_meters":{"type":"number","title":"Depth Meters"}},"type":"object","required":["timestamp_utc","latitude_degrees","longitude_degrees","grid_interval_meters","target_strength_db","is_tide_corrected","uploaded_to_cloud","number_of_points","depth_meters"],"title":"GriddedBottomDetection"},"GriddedInwaterDetection":{"properties":{"timestamp_utc":{"type":"number","title":"Timestamp Utc"},"latitude_degrees":{"type":"number","title":"Latitude Degrees"},"longitude_degrees":{"type":"number","title":"Longitude Degrees"},"grid_interval_meters":{"type":"number","title":"Grid Interval Meters"},"target_strength_db":{"type":"number